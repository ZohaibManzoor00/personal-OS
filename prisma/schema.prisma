generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  nodes       Node[]
  routeCovers RouteCover[]
  diagrams    Diagram[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Node {
  id    String @id @default(cuid())
  title String
  slug  String

  /// Which top-level app route this node belongs to (e.g. "learnings",
  /// "career", "projects", "workflows"). Scopes every query so each route is
  /// its own independent knowledge base sharing the same shape.
  section String @default("learnings")

  type NodeType

  /// Rich text content (Markdown, HTML, or Tiptap JSON string)
  body String? @db.Text

  /// Manual ordering of siblings
  sortOrder Int @default(0)

  /// When true this node (and its subtree) is personal: only the owner can see
  /// or open it. Non-owner reads never pull locked nodes.
  locked Boolean @default(false)

  /// Emoji or icon name
  icon String?

  parentId String?
  parent   Node?   @relation("NodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Node[]  @relation("NodeTree")

  images   NodeImage[]
  chunks   NodeChunk[]
  diagrams Diagram[]   @relation("NodeDiagrams")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  archivedAt   DateTime?
  lastViewedAt DateTime?

  /// AI embeddings bookkeeping. `embeddedAt` is when this node's body was last
  /// turned into vector chunks; `embeddedHash` is a hash of the exact content
  /// that was embedded. A node is "stale" (needs re-embedding) when it has never
  /// been embedded or its content hash no longer matches. The syncEmbeddings job
  /// uses these to only (re)embed what actually changed. See src/inngest.
  embeddedAt   DateTime?
  embeddedHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Postgres full-text index over title (weight A) + body (weight B). Created
  /// as a STORED generated column via raw SQL (see prisma/sql), so it is
  /// auto-maintained by Postgres on every write. Not queryable through the
  /// Prisma Client — use $queryRaw with @@ / to_tsquery against it.
  searchVector Unsupported("tsvector")? @default(dbgenerated())

  @@unique([userId, section, parentId, slug])
  @@index([userId])
  @@index([userId, section])
  @@index([parentId])
  @@index([userId, lastViewedAt])
  @@index([searchVector], type: Gin)
}

model NodeImage {
  id String @id @default(cuid())

  nodeId String
  node   Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  /// Public URL returned from your storage provider
  url String

  /// Storage path/key (useful for deletes & migrations)
  storageKey String

  filename String?
  altText  String?

  width  Int?
  height Int?

  createdAt DateTime @default(now())

  @@index([nodeId])
}

/// One embedded slice of a Node's body. A node's content is split into chunks
/// and each chunk gets its own vector, so semantic search can match the most
/// relevant passage instead of a whole document. These rows are fully rebuilt
/// by the syncEmbeddings job whenever a node's content changes.
model NodeChunk {
  id String @id @default(cuid())

  nodeId String
  node   Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  /// Denormalized from Node so vector search can filter by owner + section
  /// (and reuse the same locked-section rules as full-text search) without a join.
  userId  String
  section String

  /// 0-based position of this chunk within the node's body.
  chunkIndex Int

  /// The plain-text passage that was embedded (kept so results can show a snippet).
  content String @db.Text

  /// pgvector embedding — OpenAI text-embedding-3-small (1536 dims). Declared as
  /// Unsupported + dbgenerated so Prisma leaves it alone: the `vector` column and
  /// its HNSW index are created via prisma/sql (see node_chunk_embedding.sql) and
  /// read/written with raw SQL, exactly like Node.searchVector.
  embedding Unsupported("vector(1536)")? @default(dbgenerated())

  createdAt DateTime @default(now())

  @@unique([nodeId, chunkIndex])
  @@index([userId, section])
}

enum NodeType {
  SPACE
  PAGE
}

/// A standalone Excalidraw scene that can be embedded inside a page's Markdown
/// body via a fenced `excalidraw` token carrying this row's id. Each diagram is
/// independent: it owns its own scene and viewport, is fully interactive for
/// anyone viewing, but only the owner can persist changes (everyone else's edits
/// reset on refresh because the scene is only ever read once into initialData).
model Diagram {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Optional owning page: scopes reads to that page's visibility and cascades
  /// cleanup when the page is deleted. Removing the token from the body leaves
  /// the row (orphan) — it is not garbage collected.
  nodeId String?
  node   Node?   @relation("NodeDiagrams", fields: [nodeId], references: [id], onDelete: Cascade)

  title String?

  /// The Excalidraw scene: `{ elements: ExcalidrawElement[], files?: BinaryFiles }`.
  /// Raster images live inline as base64 in `files` (fine for shape diagrams).
  scene Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([nodeId])
}

/// A full-width cover/banner image for a top-level app route (e.g. the
/// Dashboard, Knowledge, or Career pages). One per (user, route). Unlike
/// NodeImage these are not tied to a Node — routes are not database rows.
model RouteCover {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Route key this cover belongs to, e.g. "dashboard" | "knowledge" | "career".
  route String

  /// Public URL returned from storage.
  url String

  /// Storage path/key (useful for deletes & migrations).
  storageKey String

  width  Int?
  height Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, route])
  @@index([userId])
}
